# Ruxsat berilgan hostlar (* - barcha hostlar)
AllowedHosts=*

# JWT avtorizatsiya uchun maxfiy kalit (kamida 32 ta belgi bo'lishi shart)
JwtSettings__SecretKey=your_very_secret_key_at_least_32_characters_long

# Ma'lumotlar bazasiga (SQLite) ulanish qatori
ConnectionStrings__DefaultConnection=Data Source=bookstore.db
